{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "app.exit": "ctrl+c,ctrl+d",
    "session.queued_prompts": "<leader>q",
    "prompt.queue": "alt+return",
    "input.newline": "shift+return,ctrl+return,ctrl+j"
  },
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "diffs": {
    "wrap": "word",
    "single": true,
    "view": "unified",
    "tree": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "new_location": "launch",
    "permissions": "autoaccept"
  },
  "animations": true,
  "tabs": {
    "enabled": false,
    "mode": "off",
    "layout": "horizontal",
    "indicators": "status"
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "prompt": {
    "paste": "compact",
    "image_preview": false
  }
}

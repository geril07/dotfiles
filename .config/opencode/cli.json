{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "app.exit": "ctrl+c,ctrl+d",
    "session.queued_prompts": "<leader>q",
    "prompt.queue": "alt+return",
    "input.newline": "shift+return,ctrl+return,ctrl+j"
  },
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered"
  },
  "animations": true,
  "tabs": {
    "enabled": false
  },
  "plugins": ["./herdr-opencode"]
}

{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "permissions": [
    {
      "action": "question",
      "resource": "*",
      "effect": "deny",
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/rtk/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/skills/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.cache/opencode/packages/oh-my-openagent@latest/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/code/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/my/**",
      "effect": "allow",
    },
    {
      "action": "edit",
      "resource": "~/.agents/skills/**",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow",
    },
  ],
  "plugins": [
    {
      "package": "@plannotator/opencode@latest",
      "options": {
        "workflow": "manual",
        "runtime": "embedded",
      },
    },
  ],
  "agents": {
    "general": {
      "disabled": false,
    },
    "explore": {
      "disabled": false,
    },
    "deepseek-v4-flash": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash#max",
    },
    "deepseek-v4-pro": {
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro#max",
    },
    "mimo-v2.5-pro": {
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5-pro#high",
    },
    "minimax-m3": {
      "mode": "subagent",
      "model": "opencode-go/minimax-m3#thinking",
    },
    "orch-explore": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash#max",
      "description": "",
    },
    "orch-implement": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash#max",
      "description": "",
    },
    "orch-review": {
      "mode": "subagent",
      "model": "opencode-go/minimax-m3#thinking",
      "description": "",
    },
    "title": {
      "model": "openrouter/google/gemini-3.1-flash-lite",
    },
  },
  "formatter": {
    "gofmt": {
      "disabled": true,
    },
    "rustfmt": {
      "disabled": true,
    },
    "mix": {
      "disabled": true,
    },
    "prettier": {
      "disabled": false,
    },
    "biome": {
      "disabled": true,
    },
    "zig": {
      "disabled": true,
    },
    "clang-format": {
      "disabled": true,
    },
    "ktlint": {
      "disabled": true,
    },
    "ruff": {
      "disabled": true,
    },
    "rubocop": {
      "disabled": true,
    },
    "standardrb": {
      "disabled": true,
    },
    "htmlbeautifier": {
      "disabled": true,
    },
  },
  "lsp": {
    "typescript": {
      "disabled": true,
    },
    "eslint": {
      "disabled": true,
    },
    "gopls": {
      "disabled": true,
    },
    "ruby-lsp": {
      "disabled": true,
    },
    "pyright": {
      "disabled": true,
    },
    "elixir-ls": {
      "disabled": true,
    },
    "zls": {
      "disabled": true,
    },
    "csharp": {
      "disabled": true,
    },
    "vue": {
      "disabled": true,
    },
    "rust": {
      "disabled": true,
    },
    "clangd": {
      "disabled": true,
    },
    "svelte": {
      "disabled": true,
    },
  },
  "mcp": {
    "servers": {
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "disabled": false,
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}",
        },
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "disabled": false,
      },
      "ave-atlassian": {
        "type": "local",
        "command": ["uvx", "mcp-atlassian"],
        "disabled": false,
        "environment": {
          "CONFLUENCE_URL": "{env:AVE_CONFLUENCE_URL}",
          "CONFLUENCE_PERSONAL_TOKEN": "{env:AVE_CONFLUENCE_API_KEY}",
        },
      },
      "grep-app": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false,
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-g", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true,
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--isolated",
          "--browser=chromium",
        ],
        "disabled": true,
      },
    },
  },
  "providers": {
    "ollama": {
      "name": "Ollama",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1",
      },
      "models": {
        "qwen3.5:4b": {
          "name": "qwen3.5:4b",
        },
        "qwen3.5:9b": {
          "name": "qwen3.5:9b",
        },
      },
    },
    "anthropic": {
      "settings": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy",
      },
    },
    "google": {
      "settings": {
        "apiKey": "{env:GEMINI_API_KEY}",
      },
    },
    "deepseek": {
      "settings": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
      },
    },
    "openrouter": {
      "settings": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
      },
      "models": {
        "z-ai/glm-5.2": {
          "settings": {
            "provider": {
              "order": ["z-ai/fp8"],
              "allow_fallbacks": false,
            },
          },
        },
        "moonshotai/kimi-k2.6": {
          "settings": {
            "provider": {
              "order": ["moonshotai/int4"],
              "allow_fallbacks": false,
            },
          },
        },
        "minimax/minimax-m2.7": {
          "settings": {
            "provider": {
              "only": ["minimax/fp8"],
              "order": ["minimax/fp8"],
              "allow_fallbacks": false,
            },
          },
        },
        "google/gemini-3.1-flash-lite-preview": {
          "settings": {
            "provider": {
              "order": ["google-ai-studio"],
              "allow_fallbacks": false,
            },
          },
        },
        "google/gemini-3.1-flash-lite": {
          "settings": {
            "provider": {
              "order": ["google-ai-studio"],
              "allow_fallbacks": false,
            },
          },
        },
        "google/gemini-3-flash-preview": {
          "settings": {
            "provider": {
              "order": ["google-ai-studio"],
              "allow_fallbacks": false,
            },
          },
        },
        "google/gemini-3-pro-preview": {
          "settings": {
            "provider": {
              "order": ["google-ai-studio"],
              "allow_fallbacks": false,
            },
          },
        },
        "openai/gpt-oss-120b": {
          "settings": {
            "provider": {
              "require_parameters": true,
              "order": ["fireworks", "groq"],
              "allow_fallbacks": false,
            },
          },
        },
        "openai/gpt-oss-20b": {
          "settings": {
            "provider": {
              "order": ["groq"],
              "allow_fallbacks": false,
            },
          },
        },
      },
    },
    "openai": {},
    "zai": {},
    "xai": {},
  },
}

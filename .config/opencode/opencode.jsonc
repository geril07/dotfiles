{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "compaction": {
    "auto": false,
  },
  "permissions": [
    {
      "action": "question",
      "resource": "*",
      "effect": "deny",
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/rtk/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/skills/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/.cache/opencode/packages/oh-my-openagent@latest/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/code/**",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "~/my/**",
      "effect": "allow",
    },
    {
      "action": "edit",
      "resource": "~/.agents/skills/**",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow",
    },
  ],
  "plugins": [
    "-opencode.browser",
    {
      "package": "@plannotator/opencode@latest",
      "options": {
        "workflow": "manual",
        "runtime": "embedded"
      }
    },
    "@openchamber/opencode-claude"
  ],
  "agents": {
    "general": {
      "disabled": false,
    },
    "explore": {
      "disabled": true,
    },
    "explorer": {
      "model": "openai/gpt-6-luna-fast#high",
    },
    "researcher": {
      "model": "openai/gpt-6-luna-fast#xhigh",
    },
    "reviewer": {
      "model": "openai/gpt-6.1-sol#high",
    },
    "e2e-verifier": {
      "model": "openai/gpt-6.1-sol#medium",
    },
    "worker": {
      "model": "openai/gpt-6.1-sol#medium",
    },
    // "title": {
    //   "model": "openrouter/google/gemini-3.1-flash-lite",
    // },
  },
  "mcp": {
    "servers": {
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "disabled": false,
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}",
        },
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "disabled": true,
      },
      "ave-atlassian": {
        "type": "local",
        "command": ["uvx", "mcp-atlassian"],
        "disabled": true,
        "environment": {
          "CONFLUENCE_URL": "{env:AVE_CONFLUENCE_URL}",
          "CONFLUENCE_PERSONAL_TOKEN": "{env:AVE_CONFLUENCE_API_KEY}",
        },
      },
      "grep-app": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false,
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-g", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true,
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--isolated",
          "--browser=chromium",
        ],
        "disabled": true,
      },
    },
  },
  "providers": {
    "ollama": {
      "name": "Ollama",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1",
      },
      "models": {
        "qwen3.5:4b": {
          "name": "qwen3.5:4b",
        },
        "qwen3.5:9b": {
          "name": "qwen3.5:9b",
        },
      },
    },
    "anthropic": {
      "settings": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy",
      },
    },
    "google": {
      "settings": {
        "apiKey": "{env:GEMINI_API_KEY}",
      },
    },
    "deepseek": {
      "settings": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
      },
    },
    "openrouter": {
      "settings": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
      },
      "models": {
        "z-ai/glm-5.2": {
          "settings": {
            "provider": {
              "order": ["z-ai/fp8"],
              "allow_fallbacks": false,
            },
          },
        },
        "moonshotai/kimi-k2.6": {
          "settings": {
            "provider": {
              "order": ["moonshotai/int4"],
              "allow_fallbacks": false,
            },
          },
        },
        "minimax/minimax-m2.7": {
          "settings": {
            "provider": {
              "only": ["minimax/fp8"],
              "order": ["minimax/fp8"],
              "allow_fallbacks": false,
            },
          },
        },
        "google/gemini-3.1-flash-lite-preview": {
          "settings": {
            "provider": {
              "order": ["google-ai-studio"],
              "allow_fallbacks": false,
            },
          },
        },
        "google/gemini-3.1-flash-lite": {
          "settings": {
            "provider": {
              "order": ["google-ai-studio"],
              "allow_fallbacks": false,
            },
          },
        },
        "google/gemini-3-flash-preview": {
          "settings": {
            "provider": {
              "order": ["google-ai-studio"],
              "allow_fallbacks": false,
            },
          },
        },
        "google/gemini-3-pro-preview": {
          "settings": {
            "provider": {
              "order": ["google-ai-studio"],
              "allow_fallbacks": false,
            },
          },
        },
        "openai/gpt-oss-120b": {
          "settings": {
            "provider": {
              "require_parameters": true,
              "order": ["fireworks", "groq"],
              "allow_fallbacks": false,
            },
          },
        },
        "openai/gpt-oss-20b": {
          "settings": {
            "provider": {
              "order": ["groq"],
              "allow_fallbacks": false,
            },
          },
        },
      },
    },
    "openai": {},
    "zai": {},
    "xai": {},
  },
}

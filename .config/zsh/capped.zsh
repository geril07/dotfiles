# Agent resource scope for capped. Sourced from ~/.zshrc.

# Agent resource scope. CPUQuota is percent of ONE core: 500% = 5 cores.
# AGENT_CPU_QUOTA keeps the historical percent semantics (300 = 300%); -c takes
# cores (8 = 800%), and 800% is accepted in both.
# MemoryHigh is the soft throttle, MemoryMax the hard OOM limit. All runs share
# AGENT_SLICE, whose MemoryMax is the aggregate budget; the per-scope MemoryMax
# is each run's ceiling, not a reservation. Swap is separate: each run may use
# AGENT_MEMORY_SWAP_MAX of zram (0 = no swap, off = no per-run limit), and the
# slice caps the aggregate. Work delegated to an existing service (Docker, a
# tmux server started outside the scope) is outside it.
# The shared slice is generated by `capped install` from _capped_slice_props
# below; without it systemd creates an unbounded capped.slice.
: ${AGENT_MEMORY_HIGH:=5G}
: ${AGENT_MEMORY_MAX:=6G}
: ${AGENT_MEMORY_SWAP_MAX:=2G}
: ${AGENT_CPU_QUOTA:=500%}
: ${AGENT_SLICE=capped.slice}
: ${AGENT_TMUX_ISOLATE:=1}         # private tmux server inside the scope
: ${AGENT_STOP_ON_EXIT:=0}         # keep dev servers after the agent exits

# Aggregate slice budget; `capped install` writes this to
# ~/.config/systemd/user/capped.slice.
_capped_slice_props=(
  "MemoryHigh=10G"
  "MemoryMax=12G"
  "MemorySwapMax=4G"
)

_capped_size() {
  local v=$1
  if [[ $v == off || $v == 0 ]]; then
    print -r -- infinity
  elif [[ $v == <-> ]]; then
    print -r -- "${v}G"
  else
    print -r -- "$v"
  fi
}

_capped_swap_size() {
  local v=$1
  if [[ $v == off ]]; then
    print -r -- infinity
  elif [[ $v == 0 ]]; then
    print -r -- 0
  elif [[ $v == <-> ]]; then
    print -r -- "${v}G"
  else
    print -r -- "$v"
  fi
}

_capped_cpu() {
  local q=$1 mode=${2:-cores}
  if [[ $q == off || $q == 0 ]]; then
    print -r -- ''
  elif [[ $q == *% ]]; then
    print -r -- "$q"
  elif [[ $q == <-> ]]; then
    if [[ $mode == percent ]]; then
      print -r -- "${q}%"
    else
      print -r -- "$(( q * 100 ))%"
    fi
  else
    print -u2 "capped: invalid CPU quota: $q (use 8, 800%, or off)"
    return 1
  fi
}

_capped_tmux_dir() {
  print -r -- "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/capped-tmux-${1%.scope}"
}

# Only scopes created by capped: the agent- prefix alone is not a marker.
_capped_units() {
  local u
  local -a out=()
  for u in ${(f)"$(systemctl --user list-units 'agent-*.scope' --state=active --no-legend --plain 2>/dev/null | awk '{print $1}')"}; do
    [[ "$(systemctl --user show "$u" -p Description --value 2>/dev/null)" == capped\ * ]] && out+=( "$u" )
  done
  (( ${#out} )) && print -r -l -- "${out[@]}"
}

_capped_current_unit() {
  local state_dir=${XDG_CACHE_HOME:-$HOME/.cache}/capped

  if [[ -n $CAPPED_SCOPE ]] && systemctl --user is-active --quiet "$CAPPED_SCOPE"; then
    print -r -- "$CAPPED_SCOPE"
    return 0
  fi

  local -a units
  units=(${(f)"$(_capped_units)"})
  if (( ${#units} > 1 )); then
    print -u2 'capped: multiple active scopes; use --unit:'
    print -u2 -l -- "${units[@]}"
    return 1
  fi

  if [[ -r $state_dir/last ]]; then
    local u=$(<"$state_dir/last")
    if systemctl --user is-active --quiet "$u"; then
      print -r -- "$u"
      return 0
    fi
  fi

  if (( ${#units} == 1 )); then
    print -r -- "${units[1]}"
    return 0
  fi

  print -u2 'capped: no active capped scope'
  return 1
}

_capped_tune() {
  local unit=
  local -a props=()
  local q t

  while (( $# )); do
    case $1 in
      --unit)
        (( $# >= 2 )) || { print -u2 'capped tune: --unit requires a value'; return 2; }
        unit=$2; shift 2 ;;
      --) shift; break ;;
      mem=*) props+=( "MemoryMax=$(_capped_size "${1#mem=}")" ); shift ;;
      high=*) props+=( "MemoryHigh=$(_capped_size "${1#high=}")" ); shift ;;
      swap=*) props+=( "MemorySwapMax=$(_capped_swap_size "${1#swap=}")" ); shift ;;
      cpu=*) q=$(_capped_cpu "${1#cpu=}") || return; props+=( "CPUQuota=$q" ); shift ;;
      tasks=*) t=${1#tasks=}; [[ $t == off ]] && t=infinity; props+=( "TasksMax=$t" ); shift ;;
      *) print -u2 "capped tune: unknown property: $1"; return 2 ;;
    esac
  done

  if [[ -z $unit ]]; then
    unit=$(_capped_current_unit) || return
  fi
  [[ $unit != *.scope ]] && unit="${unit}.scope"
  systemctl --user is-active --quiet "$unit" || {
    print -u2 "capped tune: $unit is not active"
    return 1
  }

  if (( ${#props} == 0 )); then
    systemctl --user show "$unit" \
      -p Id,MemoryCurrent,MemoryHigh,MemoryMax,MemorySwapMax,CPUQuotaPerSecUSec,TasksCurrent,TasksMax,OOMPolicy
    return
  fi

  systemctl --user set-property --runtime "$unit" "${props[@]}" || return
  systemctl --user show "$unit" \
    -p Id,MemoryCurrent,MemoryHigh,MemoryMax,MemorySwapMax,CPUQuotaPerSecUSec,TasksCurrent,TasksMax,OOMPolicy
}

_capped_ps() {
  local -a units
  units=(${(f)"$(_capped_units)"})
  if (( ${#units} == 0 )); then
    print -r -- 'no active capped scopes'
    return 0
  fi
  local u d
  for u in "${units[@]}"; do
    d=$(_capped_tmux_dir "$u")
    if [[ -d $d ]]; then
      print -r -- "$u  (tmux: TMUX_TMPDIR=$d)"
    else
      print -r -- "$u"
    fi
  done
  print -r -- 'use: capped tune --unit <unit>'
}

_capped_stop() {
  local unit= all=0
  while (( $# )); do
    case $1 in
      --unit)
        (( $# >= 2 )) || { print -u2 'capped stop: --unit requires a value'; return 2; }
        unit=$2; shift 2 ;;
      --all) all=1; shift ;;
      *) print -u2 "capped stop: unknown option: $1"; return 2 ;;
    esac
  done

  local -a units

  if (( all )); then
    units=(${(f)"$(_capped_units)"})
    (( ${#units} )) || { print -r -- 'no active capped scopes'; return 0; }
  else
    if [[ -z $unit ]]; then
      unit=$(_capped_current_unit) || return
    fi
    [[ $unit != *.scope ]] && unit="${unit}.scope"
    systemctl --user is-active --quiet "$unit" || {
      print -u2 "capped stop: $unit is not active"
      return 1
    }
    units=( "$unit" )
  fi

  local u rc=0
  for u in "${units[@]}"; do
    if systemctl --user stop "$u"; then
      rm -rf -- "$(_capped_tmux_dir "$u")"
    else
      print -u2 "capped stop: failed to stop $u"
      rc=1
    fi
  done
  return $rc
}

_capped_install() {
  local dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
  local file=$dir/capped.slice

  mkdir -p -- "$dir" || return
  {
    print -r -- '# Managed by `capped install`; edit ~/.config/zsh/capped.zsh.'
    print -r -- '[Unit]'
    print -r -- 'Description=capped shared budget'
    print -r -- ''
    print -r -- '[Slice]'
    print -r -- 'MemoryAccounting=yes'
    print -r -- 'CPUAccounting=yes'
    print -r -l -- "${_capped_slice_props[@]}"
  } >| "$file" || return
  chmod 600 -- "$file" || return

  systemctl --user daemon-reload || return
  systemctl --user start capped.slice 2>/dev/null || true
  systemctl --user set-property --runtime capped.slice "${_capped_slice_props[@]}" || return
  systemctl --user show capped.slice -p Id,MemoryHigh,MemoryMax,MemorySwapMax
}

_capped_usage() {
  print -r -- 'usage: capped [options] <command> [args...]'
  print -r -- '  -m, --mem SIZE      hard memory limit (default 6G; 0/off = unlimited)'
  print -r -- '      --high SIZE     soft limit (default 5G; with -m defaults to max)'
  print -r -- '      --swap SIZE     swap/zram limit (default 2G; 0 = no swap, off = unlimited)'
  print -r -- '  -c, --cpu QUOTA     CPU: 8 = 8 cores, 800%, off (default 500%)'
  print -r -- '  -n, --name NAME     unit name suffix'
  print -r -- '      --slice SLICE   systemd slice (default capped.slice; --slice= = app.slice)'
  print -r -- '      --stop|--keep   stop or keep the scope after the command exits'
  print -r -- '      --shared-tmux   use the caller tmux server'
  print -r -- ''
  print -r -- '       capped install'
  print -r -- '       capped tune [mem=SIZE] [high=SIZE] [swap=SIZE] [cpu=QUOTA|off] [tasks=N] [--unit UNIT]'
  print -r -- '       capped ps'
  print -r -- '       capped stop [--unit UNIT] [--all]'
}

capped() {
  emulate -L zsh

  case $1 in
    -h|--help) _capped_usage; return 0 ;;
    install) shift; _capped_install "$@"; return ;;
    tune) shift; _capped_tune "$@"; return ;;
    ps) shift; _capped_ps "$@"; return ;;
    stop) shift; _capped_stop "$@"; return ;;
  esac

  local high=${AGENT_MEMORY_HIGH:-5G}
  local max=${AGENT_MEMORY_MAX:-6G}
  local swap=${AGENT_MEMORY_SWAP_MAX:-2G}
  local cpu=${AGENT_CPU_QUOTA:-500%}
  local cpu_mode=percent
  local slice=${AGENT_SLICE:-}
  local tmux_isolate=${AGENT_TMUX_ISOLATE:-1}
  local stop_on_exit=${AGENT_STOP_ON_EXIT:-0}
  local name=
  local high_set=0 max_set=0 swap_set=0 cpu_set=0 slice_set=0

  while (( $# )); do
    case $1 in
      -m|--mem)
        (( $# >= 2 )) || { print -u2 'capped: -m/--mem requires a value'; return 2; }
        max=$2; max_set=1; shift 2 ;;
      --mem=*) max=${1#--mem=}; max_set=1; shift ;;
      --high)
        (( $# >= 2 )) || { print -u2 'capped: --high requires a value'; return 2; }
        high=$2; high_set=1; shift 2 ;;
      --high=*) high=${1#--high=}; high_set=1; shift ;;
      --swap)
        (( $# >= 2 )) || { print -u2 'capped: --swap requires a value'; return 2; }
        swap=$2; swap_set=1; shift 2 ;;
      --swap=*) swap=${1#--swap=}; swap_set=1; shift ;;
      -c|--cpu)
        (( $# >= 2 )) || { print -u2 'capped: -c/--cpu requires a value'; return 2; }
        cpu=$2; cpu_set=1; cpu_mode=cores; shift 2 ;;
      --cpu=*) cpu=${1#--cpu=}; cpu_set=1; cpu_mode=cores; shift ;;
      -n|--name)
        (( $# >= 2 )) || { print -u2 'capped: -n/--name requires a value'; return 2; }
        name=$2; shift 2 ;;
      --name=*) name=${1#--name=}; shift ;;
      --slice)
        (( $# >= 2 )) || { print -u2 'capped: --slice requires a value'; return 2; }
        slice=$2; slice_set=1; shift 2 ;;
      --slice=*) slice=${1#--slice=}; slice_set=1; shift ;;
      --stop) stop_on_exit=1; shift ;;
      --keep) stop_on_exit=0; shift ;;
      --shared-tmux) tmux_isolate=0; shift ;;
      --) shift; break ;;
      -*) print -u2 "capped: unknown option: $1"; return 2 ;;
      *) break ;;
    esac
  done

  (( $# )) || { _capped_usage >&2; return 2; }
  [[ -n $max && -n $high && -n $swap && -n $cpu ]] || {
    print -u2 'capped: empty SIZE/QUOTA value'
    return 2
  }
  if [[ $slice == capped.slice ]]; then
    local slice_max
    slice_max=$(systemctl --user show capped.slice -p MemoryMax --value 2>/dev/null)
    if [[ -z $slice_max || $slice_max == infinity ]]; then
      print -u2 'capped: capped.slice has no MemoryMax; run `capped install`'
    fi
  fi

  # An explicit max override also drops the soft limit unless --high was given.
  if (( max_set )) && (( ! high_set )); then
    high=$max
  fi

  local max_value high_value swap_value cpu_value
  max_value=$(_capped_size "$max") || return
  high_value=$(_capped_size "$high") || return
  swap_value=$(_capped_swap_size "$swap") || return
  cpu_value=$(_capped_cpu "$cpu" "$cpu_mode") || return

  # Already inside a capped scope: run in place, never nest another scope.
  if [[ -n $CAPPED_SCOPE ]] && systemctl --user is-active --quiet "$CAPPED_SCOPE"; then
    if (( max_set || high_set || swap_set || cpu_set || slice_set )); then
      print -u2 "capped: already inside $CAPPED_SCOPE; scope options ignored"
    fi
    if (( $+aliases[$1] || $+functions[$1] )); then
      zsh -ic "${(j: :)${(q)@}}"
    else
      "$@"
    fi
    return
  fi

  local -a run=()
  if (( $+aliases[$1] || $+functions[$1] )); then
    # systemd-run execs directly; reload startup-defined aliases/functions in a shell.
    run=( zsh -ic "${(j: :)${(q)@}}" )
  else
    run=( "$@" )
  fi

  local unit_id base
  unit_id=$(systemd-id128 new) || return
  base=${name:-$(basename -- "$1")}
  base=${base//[^a-zA-Z0-9_.-]/-}
  [[ -n $base ]] || base=cmd
  local unit="agent-${base}-${unit_id}"
  local unit_scope="${unit}.scope"

  local state_dir=${XDG_CACHE_HOME:-$HOME/.cache}/capped
  mkdir -p -- "$state_dir" || return
  print -r -- "$unit_scope" >| "$state_dir/last"

  local -a props=( "MemoryMax=$max_value" "MemorySwapMax=$swap_value" )
  [[ $high_value != infinity ]] && props+=( "MemoryHigh=$high_value" )
  [[ -n $cpu_value ]] && props+=( "CPUQuota=$cpu_value" )
  props+=( "OOMPolicy=continue" "Delegate=yes" "TimeoutStopSec=15s" )

  local -a prop_args=()
  local p
  for p in "${props[@]}"; do
    prop_args+=( -p "$p" )
  done

  local -a slice_args=()
  [[ -n $slice ]] && slice_args=( --slice="$slice" )

  if (( tmux_isolate )); then
    local tmux_dir=$(_capped_tmux_dir "$unit")
    mkdir -p -- "$tmux_dir" || return
    chmod 700 -- "$tmux_dir" || return
    run=( env -u TMUX -u TMUX_PANE "TMUX_TMPDIR=$tmux_dir" "${run[@]}" )
  fi

  [[ -t 2 ]] && print -u2 "capped: ${unit_scope} (high ${high_value}, max ${max_value}, cpu ${cpu_value:-off})"

  systemd-run --user --scope --quiet --collect --expand-environment=no \
    --unit="$unit" \
    --description="capped ${1//\%/%%}" \
    --setenv="CAPPED_SCOPE=$unit_scope" \
    "${slice_args[@]}" "${prop_args[@]}" -- "${run[@]}"
  local rc=$?

  (( stop_on_exit )) && systemctl --user stop "$unit_scope" 2>/dev/null

  local cg
  # Check descendants too; the scope can disappear between the query and the read.
  if cg=$(systemctl --user show "$unit_scope" -p ControlGroup --value 2>/dev/null); then
    if [[ -z $cg ]] || grep -qx 'populated 0' "/sys/fs/cgroup$cg/cgroup.events" 2>/dev/null ||
      { [[ ! -d "/sys/fs/cgroup$cg" ]] &&
        cg=$(systemctl --user show "$unit_scope" -p ControlGroup --value 2>/dev/null) &&
        [[ -z $cg ]]; }; then
      rm -rf -- "$(_capped_tmux_dir "$unit_scope")"
      if [[ -r $state_dir/last && "$(<"$state_dir/last")" == "$unit_scope" ]]; then
        rm -f -- "$state_dir/last"
      fi
    fi
  fi

  (( rc == 137 )) && print -u2 'capped: command exited with SIGKILL; if this was OOM, check `capped ps` for surviving children'
  return $rc
}

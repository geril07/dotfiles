#!/usr/bin/env python3
"""Check or connect Claude Code profiles to the shared dotfiles plugin."""

import argparse
import copy
import json
import os
from pathlib import Path
import re
import shutil
import sys
import tempfile


REPO = Path(__file__).resolve().parents[1]


def merge(target, source):
    result = copy.deepcopy(target)
    for key, value in source.items():
        if isinstance(value, dict):
            previous = result.get(key, {})
            if not isinstance(previous, dict):
                raise ValueError(f"settings.{key} must be an object")
            result[key] = merge(previous, value)
        else:
            result[key] = value
    return result


def partition_hooks(settings):
    hooks = settings.get("hooks", {})
    if not isinstance(hooks, dict):
        raise ValueError("settings.hooks must be an object")
    other, orca = {}, {}
    for event, groups in hooks.items():
        if not isinstance(groups, list):
            raise ValueError(f"settings.hooks.{event} must be an array")
        kept, selected = [], []
        for group in groups:
            if not isinstance(group, dict) or not isinstance(group.get("hooks"), list):
                raise ValueError(f"Invalid hook group in {event}")
            remaining, commands = [], []
            for hook in group["hooks"]:
                if not isinstance(hook, dict):
                    raise ValueError(f"Invalid hook in {event}")
                command = hook.get("command", "")
                is_orca = isinstance(command, str) and ".orca/agent-hooks/claude-hook." in command
                (commands if is_orca else remaining).append(hook)
            if commands:
                selected.append({**group, "hooks": commands})
            if remaining or not commands:
                kept.append({**group, "hooks": remaining})
        if kept or not groups:
            other[event] = kept
        if selected:
            orca[event] = selected
    return other, orca


def sync_orca(settings, source):
    other, _ = partition_hooks(settings)
    for event, groups in source.items():
        other.setdefault(event, []).extend(copy.deepcopy(groups))
    if other or "hooks" in settings:
        settings["hooks"] = other


def read_settings(path):
    if path.is_symlink() and not path.exists():
        raise ValueError(f"Broken settings symlink: {path}")
    settings = json.loads(path.read_text()) if path.exists() else {}
    if not isinstance(settings, dict):
        raise ValueError(f"Expected a settings object: {path}")
    return settings


def directory(path):
    if path.is_symlink():
        raise ValueError(f"Directory is a symlink; refusing to follow it: {path}")
    if path.exists() and not path.is_dir():
        raise ValueError(f"Expected a directory: {path}")


def plan_link(path, target):
    if path.is_symlink():
        if path.resolve() == target.resolve():
            return []
        raise ValueError(f"Conflicting symlink: {path} -> {os.readlink(path)}")
    elif path.exists():
        raise ValueError(f"Conflicting file or directory: {path}")
    return [("link", path, target)]


def plan_memory(profile):
    actions = []
    projects = profile / "projects"
    directory(projects)
    if projects.exists():
        for project in sorted(projects.iterdir()):
            if project.is_symlink():
                raise ValueError(f"Refusing memory cleanup through project symlink: {project}")
            if not project.is_dir():
                continue
            memory = project / "memory"
            directory(memory)
            if memory.exists():
                actions.append(("clear-memory", memory, None))
    memory = profile / "agent-memory"
    directory(memory)
    if memory.exists():
        actions.append(("clear-memory", memory, None))
    return actions


def plan_profile(profile, shared, orca, clear):
    directory(profile)
    directory(profile / "skills")
    plugin_id = "my@skills-dir"
    path = profile / "settings.json"
    settings = read_settings(path)
    desired = copy.deepcopy(settings)
    if orca is not None:
        sync_orca(desired, orca)
    desired = merge(desired, shared)
    if desired.get("enabledPlugins", {}).get(plugin_id) is not True:
        raise ValueError(f"Shared settings must enable {plugin_id}")
    actions = plan_link(profile / "skills" / "my", REPO / "claude/plugin")
    actions += plan_link(profile / "CLAUDE.md", REPO / "claude/CLAUDE.md")
    actions += plan_link(
        profile / "statusline-command.sh", REPO / "claude/statusline-command.sh",
    )
    if desired != settings or path.is_symlink() or not path.exists():
        actions.append(("settings", path, desired))
    if clear:
        actions.extend(plan_memory(profile))
    return actions


def write_settings(path, settings):
    descriptor, temporary = tempfile.mkstemp(prefix=".sync-claude-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(settings, stream, indent=2, ensure_ascii=False)
            stream.write("\n")
        # Replace the directory entry, never write through an existing settings symlink.
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="Report drift without writes (default)")
    mode.add_argument("--apply", action="store_true", help="Apply the displayed managed changes")
    parser.add_argument("--home", type=Path, default=Path.home(), help="Target home; useful for isolated tests")
    parser.add_argument("--profile", action="append", help="personal or a named profile; repeatable, creates missing profiles on apply")
    parser.add_argument("--clear-memory", action="store_true", help="Also plan deletion of auto-memory directories, never sessions")
    args = parser.parse_args()
    applying = False
    try:
        home = args.home.expanduser().absolute()
        directory(home)
        root = home / ".claude-profiles"
        directory(root)
        if args.profile:
            profiles = []
            for name in dict.fromkeys(args.profile):
                if not re.fullmatch(r"[A-Za-z0-9_-]+", name):
                    raise ValueError(f"Invalid profile name: {name!r}")
                profiles.append(home / ".claude" if name == "personal" else root / name)
        else:
            profiles = [home / ".claude"]
            if root.exists():
                profiles.extend(p for p in sorted(root.iterdir()) if p.is_dir() or p.is_symlink())
        shared = json.loads((REPO / "claude/settings.json").read_text())
        for source in [REPO / "claude/plugin/.claude-plugin/plugin.json",
                       REPO / "claude/plugin/skills", REPO / "claude/CLAUDE.md",
                       REPO / "claude/statusline-command.sh"]:
            if not source.exists():
                raise ValueError(f"Missing shared source: {source}")
        primary = home / ".claude"
        directory(primary)
        primary_settings = primary / "settings.json"
        source_orca = None
        if primary_settings.exists() or primary_settings.is_symlink():
            _, source_orca = partition_hooks(read_settings(primary_settings))
        # Preflight every profile before the first write.
        actions = []
        for profile in profiles:
            orca = source_orca if profile != primary else None
            actions.extend(plan_profile(profile, shared, orca, args.clear_memory))
        for kind, path, _ in actions:
            print(f"{kind}: {path}")
        if not args.apply:
            if actions:
                print("Drift found. No changes made; use --apply after review.")
                return 1
            print("All profiles are in sync. No changes made.")
            return 0
        applying = True
        for kind, path, value in actions:
            if kind == "clear-memory":
                shutil.rmtree(path)
                continue
            path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            if kind == "link":
                if path.is_symlink():
                    path.unlink()
                path.symlink_to(value)
            elif kind == "settings":
                write_settings(path, value)
        print(f"Applied {len(actions)} changes. Restart Claude Code or run /reload-plugins.")
        return 0
    except (OSError, ValueError) as error:
        state = "Earlier writes are not rolled back." if applying else "No changes made."
        print(f"sync-claude: {error}. {state}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())

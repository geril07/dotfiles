{
  "autoMemoryEnabled": false,
  "enabledPlugins": {
    "my@skills-dir": true
  },
  "statusLine": {
    "type": "command",
    "command": "sh \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline-command.sh\"",
    "refreshInterval": 60
  },
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "3",
    "CLAUDE_CODE_SHELL": "/bin/bash",
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}

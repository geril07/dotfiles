{
  "settings": {
    "directTools": false,
    "disableProxyTool": false
  },
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "$env:EXA_API_KEY"
      },
      "lifecycle": "eager",
      "disabled": false,
      "directTools": ["web_search_exa"],
      "includeTools": ["web_search_exa"]
    },
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "disabled": true
    },
    "grep-app": {
      "url": "https://mcp.grep.app",
      "disabled": false,
      "directTools": ["searchGitHub"],
      "includeTools": ["searchGitHub"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "disabled": true
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--browser=chromium"
      ],
      "disabled": true
    }
  }
}

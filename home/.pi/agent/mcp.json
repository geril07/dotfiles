{
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "$env:EXA_API_KEY"
      }
    },
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "ave-atlassian": {
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "CONFLUENCE_URL": "$env:AVE_CONFLUENCE_URL",
        "CONFLUENCE_PERSONAL_TOKEN": "$env:AVE_CONFLUENCE_API_KEY"
      }
    },
    "grep-app": {
      "url": "https://mcp.grep.app"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "disabled": true
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--browser=chromium"
      ],
      "disabled": true
    }
  }
}

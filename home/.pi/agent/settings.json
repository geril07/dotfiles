{
  "lastChangelogVersion": "1.3.0",
  "tuiMode": "fullscreen",
  "fullscreenWheelScrollLines": 3,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "modelThinkingLevels": {
    "openai/gpt-6-luna": "xhigh",
    "openai/gpt-6.1-sol": "low",
    "openai-codex/gpt-6-luna": "xhigh",
    "openai-codex/gpt-6.1-sol": "low",
    "claude-bridge/claude-sonnet-5-5": "high"
  },
  "editorPaddingX": 2,
  "theme": "catppuccin-macchiato",
  "defaultProjectTrust": "always",
  "outputPad": 1,
  "autocompleteMaxVisible": 20,
  "transport": "auto",
  "enableInstallTelemetry": false,
  "treeFilterMode": "no-tools",
  "showCacheMissNotices": true,
  "steeringMode": "all",
  "followUpMode": "all",
  "extensions": [
    "-builtin:mcp"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    {
      "source": "https://github.com/nicobailon/pi-subagents",
      "prompts": [],
      "skills": [],
      "extensions": []
    },
    "https://github.com/monotykamary/pi-double-esc@main",
    "npm:@narumitw/pi-goal",
    "npm:@zeldrisho/pi-web-fetch",
    "npm:@plannotator/pi-extension",
    "npm:@piotr-oles/pi-bash-timeout",
    "npm:pi-mcp-adapter",
    "npm:pi-claude-bridge",
    "npm:pi-antigravity",
    {
      "source": "/home/geril/code/my/pi-sidekicks"
    }
  ],
  "hideThinkingBlock": false,
  "compaction": {
    "enabled": false
  },
  "enabledModels": [
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6-astra",
    "antigravity/gemini-3.8-flash",
    "claude-bridge/claude-sonnet-5-5",
    "claude-bridge/claude-opus-5-5"
  ],
  "subagents": {
    "disableThinking": true,
    "disableBuiltins": true,
    "agentOverrides": {
      "explorer": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "high"
      },
      "researcher": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "low"
      },
      "reviewer": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high"
      },
      "e2e-verifier": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "low"
      },
      "worker": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "low"
      }
    }
  }
}
